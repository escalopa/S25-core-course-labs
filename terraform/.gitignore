# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Terraform variable files containing sensitive data
*.tfvars
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform lock file (optional, can be committed)
# .terraform.lock.hcl

# Terraform directory
.terraform/

# CLI configuration files
.terraformrc
terraform.rc
