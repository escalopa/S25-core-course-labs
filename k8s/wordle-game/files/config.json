{
  "app_name": "Wordle Game Application",
  "version": "1.16.0",
  "environment": "production",
  "log_level": "info",
  "game_config": {
    "max_attempts": 6,
    "word_length": 5,
    "difficulty": "medium"
  },
  "api_timeout": 30,
  "port": 8080,
  "features": {
    "cache_enabled": true,
    "persistence": true,
    "metrics": true,
    "health_check": true
  },
  "database": {
    "host": "db.default.svc.cluster.local",
    "port": 5432,
    "pool_size": 15,
    "ssl_mode": "require"
  },
  "monitoring": {
    "prometheus_enabled": true,
    "metrics_port": 9090,
    "endpoint": "/metrics"
  }
}
