{
  "app_name": "Moscow Time Application",
  "version": "1.16.0",
  "environment": "production",
  "log_level": "info",
  "timezone": "Europe/Moscow",
  "api_timeout": 30,
  "port": 5000,
  "features": {
    "cache_enabled": true,
    "persistence": true,
    "metrics": true,
    "health_check": true
  },
  "database": {
    "host": "db.default.svc.cluster.local",
    "port": 5432,
    "pool_size": 10,
    "ssl_mode": "require"
  },
  "monitoring": {
    "prometheus_enabled": true,
    "metrics_port": 9000,
    "endpoint": "/metrics"
  }
}
